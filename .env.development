# ============================================================
# 开发环境配置
# 以 VITE_ 开头的变量会被注入到客户端代码中（import.meta.env.xxx）
# ============================================================

# 站点标题
VITE_APP_TITLE=暴龙万事屋

# 接口基础路径。配合 vite.config.ts 里的 proxy，开发时由 Vite 转发到 http://localhost:8080
VITE_API_BASE_URL=/api

# 是否启用前端 Mock。
# true  = 使用本地模拟数据，不需要后端也能跑通全部页面（答辩演示推荐）
# false = 请求真实后端
VITE_USE_MOCK=true
